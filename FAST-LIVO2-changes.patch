--- a/src/preprocess.cpp
+++ b/src/preprocess.cpp
@@ -11,6 +11,8 @@ which is included as part of this source code package.
 */
 
 #include "preprocess.h"
+#include <algorithm>
+#include <utility>
 
 #define RETURN0 0x00
 #define RETURN0AND1 0x10
@@ -569,9 +571,32 @@ void Preprocess::xt32_handler(const sensor_msgs::PointCloud2::ConstPtr &msg)
   pl_corn.clear();
   pl_full.clear();
 
+  // Reject malformed/empty input before PCL conversion or indexing first/last points.
+  if (msg->width == 0 || msg->height == 0) return;
+  const std::pair<const char*, uint8_t> required[] = {
+      {"x", sensor_msgs::PointField::FLOAT32}, {"y", sensor_msgs::PointField::FLOAT32},
+      {"z", sensor_msgs::PointField::FLOAT32}, {"intensity", sensor_msgs::PointField::FLOAT32},
+      {"ring", sensor_msgs::PointField::UINT16}, {"timestamp", sensor_msgs::PointField::FLOAT64}};
+  for (const auto& field : required)
+  {
+    const auto found = std::find_if(msg->fields.begin(), msg->fields.end(),
+        [&](const sensor_msgs::PointField& f) { return f.name == field.first; });
+    if (found == msg->fields.end() || found->datatype != field.second || found->count != 1)
+    {
+      ROS_ERROR_THROTTLE(2.0, "XT input needs x/y/z/intensity float32, ring uint16, timestamp float64 seconds");
+      return;
+    }
+    const size_t bytes = field.second == sensor_msgs::PointField::FLOAT64 ? 8 :
+                         field.second == sensor_msgs::PointField::UINT16 ? 2 : 4;
+    if (uint64_t(found->offset) + bytes > msg->point_step) return;
+  }
+  if (uint64_t(msg->width) * msg->point_step > msg->row_step ||
+      uint64_t(msg->row_step) * msg->height > msg->data.size()) return;
+
   pcl::PointCloud<xt32_ros::Point> pl_orig;
   pcl::fromROSMsg(*msg, pl_orig);
   int plsize = pl_orig.points.size();
+  if (plsize == 0) return;
   pl_surf.reserve(plsize);
 
   bool is_first[MAX_LINE_NUM];
diff --git a/src/test_xt_input.cpp b/src/test_xt_input.cpp
new file mode 100644
index 0000000..56f951c
--- /dev/null
+++ b/src/test_xt_input.cpp
@@ -0,0 +1,41 @@
+#include "preprocess.h"
+#include <cmath>
+#include <iostream>
+
+int main()
+{
+  ros::Time::init();
+  Preprocess pre;
+  pre.set(false, XT32, 0.1, 1);
+  pre.blind_sqr = 0.01;
+  pre.N_SCANS = 16;
+  PointCloudXYZI::Ptr result(new PointCloudXYZI);
+  sensor_msgs::PointCloud2::Ptr msg(new sensor_msgs::PointCloud2);
+  pre.process(msg, result);
+  if (!result->empty()) return 1;
+
+  pcl::PointCloud<xt32_ros::Point> cloud;
+  xt32_ros::Point point{};
+  point.x = 2; point.y = 1; point.z = 0; point.intensity = 20;
+  point.ring = 0; point.timestamp = 100;
+  cloud.push_back(point);
+  point.ring = 15; point.timestamp = 100.1;
+  cloud.push_back(point);
+  pcl::toROSMsg(cloud, *msg);
+  pre.process(msg, result);
+  if (result->size() != 2 || std::abs(result->back().curvature - 100) > 0.001) return 2;
+
+  auto valid = *msg;
+  for (auto& f : msg->fields) if (f.name == "timestamp") f.name = "time";
+  pre.process(msg, result);
+  if (!result->empty()) return 3;
+  *msg = valid;
+  for (auto& f : msg->fields) if (f.name == "timestamp") f.datatype = sensor_msgs::PointField::FLOAT32;
+  pre.process(msg, result);
+  if (!result->empty()) return 4;
+  *msg = valid;
+  msg->data.resize(1);
+  pre.process(msg, result);
+  if (!result->empty()) return 5;
+  std::cout << "PASS: empty, valid seconds-to-ms, missing timestamp, wrong type, truncated payload\n";
+}
