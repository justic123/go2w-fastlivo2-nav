Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Enabled: true
    Name: Grid
  - Class: rviz_default_plugins/TF
    Enabled: false
    Name: Coordinate axes (not robot heading)
  - Alpha: 0.5
    Class: rviz_default_plugins/Map
    Color Scheme: map
    Enabled: true
    Name: Live navigation costmap
    Topic:
      Durability Policy: Transient Local
      Value: /global_costmap/costmap
  - Class: rviz_default_plugins/Path
    Enabled: true
    Name: Planned path
    Topic:
      Value: /plan
  - Class: rviz_default_plugins/PointCloud2
    Enabled: true
    Name: Current lidar
    Size (Pixels): 2
    Style: Points
    Topic:
      Reliability Policy: Best Effort
      Value: /mppi/cloud
  - Class: rviz_default_plugins/PointCloud2
    Enabled: false
    Name: Saved room map
    Size (Pixels): 1
    Style: Points
    Topic:
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      Value: /demo/saved_cloud
  - Class: rviz_default_plugins/Marker
    Enabled: true
    Name: Robot forward (body +X)
    Topic:
      Durability Policy: Volatile
      Reliability Policy: Reliable
      Value: /mppi/body_heading
  - Alpha: 0.5
    Class: rviz_default_plugins/Map
    Color Scheme: map
    Enabled: false
    Name: Saved floor map (available offline)
    Topic:
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      Value: /demo/saved_map
  - Alpha: 0.5
    Class: rviz_default_plugins/Map
    Color Scheme: map
    Draw Behind: false
    Enabled: false
    Name: Local obstacles + inflation (live)
    Topic:
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      Value: /local_costmap/costmap
  - Class: rviz_default_plugins/Polygon
    Color: 0; 255; 120
    Enabled: false
    Name: Robot footprint (live)
    Topic:
      Reliability Policy: Reliable
      Value: /local_costmap/published_footprint
  - Class: rviz_default_plugins/Marker
    Enabled: false
    Name: Localization status (green=live, red=offline)
    Topic:
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      Value: /demo/view_status
  Global Options:
    Fixed Frame: camera_init
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/SetInitialPose
    Topic: /initialpose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 60
Window Geometry:
  Height: 850
  Width: 1200
