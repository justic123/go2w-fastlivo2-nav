Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: map
    Background Color: 35; 38; 43
  Displays:
  - Class: rviz_default_plugins/Map
    Name: Saved map (available offline)
    Enabled: true
    Alpha: 1.0
    Color Scheme: map
    Draw Behind: true
    Topic:
      Value: /demo/saved_map
      Durability Policy: Transient Local
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/Map
    Name: Global obstacles + inflation (live)
    Enabled: false
    Alpha: 0.75
    Color Scheme: costmap
    Draw Behind: false
    Topic:
      Value: /global_costmap/costmap
      Durability Policy: Transient Local
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/Map
    Name: Local obstacles + inflation (live)
    Enabled: false
    Alpha: 0.85
    Color Scheme: costmap
    Draw Behind: false
    Topic:
      Value: /local_costmap/costmap
      Durability Policy: Transient Local
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/TF
    Name: Coordinate axes (not robot heading)
    Enabled: false
  - Class: rviz_default_plugins/Path
    Name: Planned path
    Enabled: true
    Topic:
      Value: /plan
  - Class: rviz_default_plugins/PointCloud2
    Name: Current lidar
    Enabled: true
    Topic:
      Value: /mppi/cloud
      Reliability Policy: Best Effort
    Size (Pixels): 2
    Style: Points
  - Class: rviz_default_plugins/PointCloud2
    Name: Saved room map
    Enabled: true
    Topic:
      Value: /demo/saved_cloud
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Size (Pixels): 1
    Style: Points
  - Class: rviz_default_plugins/Marker
    Name: Robot forward (body +X)
    Enabled: true
    Topic:
      Value: /mppi/body_heading
      Reliability Policy: Reliable
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Polygon
    Name: Robot footprint (live)
    Enabled: true
    Color: 0; 255; 120
    Topic:
      Value: /local_costmap/published_footprint
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/Marker
    Name: Localization status (green=live, red=offline)
    Enabled: true
    Topic:
      Value: /demo/view_status
      Durability Policy: Transient Local
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/MarkerArray
    Name: Saved points + route order + progress
    Enabled: true
    Topic:
      Value: /demo/mission
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/Path
    Name: Entire route PREVIEW (not live control)
    Enabled: true
    Color: 0; 210; 255
    Line Style: Billboards
    Line Width: 0.035
    Topic:
      Value: /demo/route_plan
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/SetInitialPose
    Topic: /initialpose
  - Class: rviz_default_plugins/SetGoal
    Topic: /demo/goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 70.0
      X: 0.0
      Y: 0.0
Window Geometry:
  Width: 1200
  Height: 850
