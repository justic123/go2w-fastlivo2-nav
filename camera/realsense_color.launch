<launch>
  <!-- Image acquisition only; camera-to-LiDAR calibration is still required. -->
  <arg name="serial_no" default=""/>
  <arg name="width" default="640"/>
  <arg name="height" default="480"/>
  <arg name="fps" default="30"/>
  <include file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="camera" value="go2w_realsense"/>
    <arg name="serial_no" value="$(arg serial_no)"/>
    <arg name="color_width" value="$(arg width)"/>
    <arg name="color_height" value="$(arg height)"/>
    <arg name="color_fps" value="$(arg fps)"/>
    <arg name="enable_color" value="true"/>
    <arg name="enable_depth" value="false"/>
    <arg name="enable_infra" value="false"/>
    <arg name="enable_infra1" value="false"/>
    <arg name="enable_infra2" value="false"/>
    <arg name="enable_confidence" value="false"/>
    <arg name="enable_gyro" value="false"/>
    <arg name="enable_accel" value="false"/>
    <arg name="enable_pointcloud" value="false"/>
    <arg name="initial_reset" value="false"/>
    <arg name="wait_for_device_timeout" value="10.0"/>
  </include>
</launch>
