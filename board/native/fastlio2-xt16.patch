+
+// Preserve supplied point times; never infer deskew timing from scan angle.
+void Preprocess::xt16_handler(const sensor_msgs::PointCloud2::ConstPtr &msg)
+{
+  pl_surf.clear();pl_corn.clear();pl_full.clear();
+  if (feature_enabled || point_filter_num < 1 || N_SCANS != 16 || msg->is_bigendian ||
+      msg->height != 1 || msg->width < 2) {
+    ROS_ERROR_THROTTLE(2., "XT16 requires normalized little-endian 16-ring input and direct matching");return;
+  }
+  const std::pair<const char*,uint8_t> required[] = {
+    {"x",7},{"y",7},{"z",7},{"intensity",7},{"ring",4},{"timestamp",8}};
+  for (const auto &field : required) {
+    auto f=std::find_if(msg->fields.begin(),msg->fields.end(),[&](const sensor_msgs::PointField &v){return v.name==field.first;});
+    const size_t bytes=field.second==8?8:field.second==4?2:4;
+    if (f==msg->fields.end() || f->datatype!=field.second || f->count!=1 ||
+        uint64_t(f->offset)+bytes>msg->point_step) {
+      ROS_ERROR_THROTTLE(2., "XT16 input fields do not match normalized bridge");return;
+    }
+  }
+  if (uint64_t(msg->width)*msg->point_step>msg->row_step ||
+      uint64_t(msg->row_step)*msg->height>msg->data.size()) return;
+  pcl::PointCloud<go2w_xt16::Point> input;pcl::fromROSMsg(*msg,input);
+  const double begin=msg->header.stamp.toSec();double previous=begin;
+  pl_surf.reserve(input.size()/point_filter_num+1);
+  for (size_t i=0;i<input.size();++i) {
+    const auto &v=input[i];const double dt=v.timestamp-begin;
+    if (!std::isfinite(v.timestamp) || v.timestamp<previous-1e-6 || dt<0 || dt>.2 || v.ring>=16 ||
+        !std::isfinite(v.x) || !std::isfinite(v.y) || !std::isfinite(v.z) || !std::isfinite(v.intensity)) {
+      pl_surf.clear();ROS_ERROR_THROTTLE(2., "XT16 point/time bounds invalid");return;
+    }
+    previous=v.timestamp;
+    if (i%point_filter_num || v.x*v.x+v.y*v.y+v.z*v.z<=blind*blind) continue;
+    PointType p{};p.x=v.x;p.y=v.y;p.z=v.z;p.intensity=v.intensity;
+    p.curvature=dt*1000.;pl_surf.push_back(p);
+  }
+}
