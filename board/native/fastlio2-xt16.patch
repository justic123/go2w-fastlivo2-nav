diff --git a/tests/go2w_xt16_check.cpp b/tests/go2w_xt16_check.cpp
new file mode 100644
index 0000000..73cc86c
--- /dev/null
+++ b/tests/go2w_xt16_check.cpp
@@ -0,0 +1,31 @@
+#include "../src/preprocess.h"
+#include <cstring>
+#include <cmath>
+#include <stdexcept>
+#include <iostream>
+
+void require(bool value,const char* reason){if(!value)throw std::runtime_error(reason);}
+sensor_msgs::PointCloud2::Ptr cloud(){
+  sensor_msgs::PointCloud2::Ptr m(new sensor_msgs::PointCloud2());
+  m->header.stamp=ros::Time(1700000000,0);m->height=1;m->width=8;m->point_step=26;m->row_step=208;m->is_bigendian=false;m->data.resize(208);
+  const char* names[]={"x","y","z","intensity","ring","timestamp"};int offsets[]={0,4,8,12,16,18};int types[]={7,7,7,7,4,8};
+  for(int i=0;i<6;++i){sensor_msgs::PointField f;f.name=names[i];f.offset=offsets[i];f.datatype=types[i];f.count=1;m->fields.push_back(f);}
+  for(size_t i=0;i<8;++i){float x=1.f+i*.1f,y=.2f,z=.3f,intensity=5.f;uint16_t ring=i;double t=1700000000.+i*.01;auto b=m->data.data()+i*26;
+    std::memcpy(b,&x,4);std::memcpy(b+4,&y,4);std::memcpy(b+8,&z,4);std::memcpy(b+12,&intensity,4);std::memcpy(b+16,&ring,2);std::memcpy(b+18,&t,8);}
+  return m;
+}
+int main(){
+  ros::Time::init();
+  try{
+    Preprocess p;p.set(false,5,.6,4);p.N_SCANS=16;p.time_unit=0;
+    PointCloudXYZI::Ptr result(new PointCloudXYZI());auto m=cloud();p.process(m,result);
+    require(result->size()==2,"point filter changed");require(std::abs(result->at(0).curvature)<.001,"first time not scan start");require(std::abs(result->at(1).curvature-40.)<.001,"point seconds were not converted to milliseconds");
+    m=cloud();m->fields.back().datatype=7;p.process(m,result);require(result->empty(),"bad timestamp field accepted");
+    m=cloud();double backwards=1699999999.;std::memcpy(m->data.data()+26+18,&backwards,8);p.process(m,result);require(result->empty(),"timestamp rollback accepted");
+    m=cloud();double late=1700000001.;std::memcpy(m->data.data()+7*26+18,&late,8);p.process(m,result);require(result->empty(),"unbounded scan accepted");
+    m=cloud();m->data.resize(5);p.process(m,result);require(result->empty(),"truncated data accepted");
+    m=cloud();uint16_t ring=16;std::memcpy(m->data.data()+16,&ring,2);p.process(m,result);require(result->empty(),"invalid ring accepted");
+    m=cloud();p.feature_enabled=true;p.process(m,result);require(result->empty(),"unsupported feature extraction accepted");
+    std::cout<<"XT16 preprocess: valid timing/filtering and 6 malformed inputs rejected"<<std::endl;return 0;
+  }catch(const std::exception& e){std::cerr<<e.what()<<std::endl;return 1;}
+}
