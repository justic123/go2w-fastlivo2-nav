diff --git a/src/board_profile.cpp b/src/board_profile.cpp
new file mode 100644
index 0000000..a192fe5
--- /dev/null
+++ b/src/board_profile.cpp
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: MIT
+#include "board_profile.h"
+#include "normal_equations.h"
+#include <ros/ros.h>
+#include <std_msgs/String.h>
+#include <map>
+#include <cmath>
+#include <cstdlib>
+#include <iomanip>
+#include <memory>
+#include <sstream>
+#include <stdexcept>
+
+namespace go2w {
+namespace {
+std::map<std::string, double> times, metrics;
+const std::string& backend() {
+  static const std::string value = [] {
+    const char* raw = std::getenv("GO2W_CUDA_BACKEND");
+    std::string v = raw ? raw : "cpu";
+    if (v != "cpu" && v != "shadow") throw std::runtime_error("GO2W_CUDA_BACKEND must be cpu or shadow");
+    return v;
+  }();
+  return value;
+}
+void json_number(std::ostream& out, double value) {
+  if (std::isfinite(value)) out << value;
+  else out << "null";
+}
+}
+bool profiling() {
+  static const bool enabled = [] { const char* p=std::getenv("GO2W_PROFILE"); return p && std::string(p)=="1"; }();
+  return enabled;
+}
+void add_time(const std::string& name, double seconds) { if (profiling()) times[name] += seconds*1000.; }
+void set_metric(const std::string& name, double value) { if (profiling()) metrics[name] = value; }
+void publish_profile() {
+  if (!profiling()) return;
+  static ros::NodeHandle node;
+  static ros::Publisher pub=node.advertise<std_msgs::String>("/go2w_lio/profile", 50);
+  static unsigned long long sequence=0;
+  std::ostringstream out;
+  out << std::setprecision(17) << "{\"schema\":1,\"sequence\":" << ++sequence
+      << ",\"backend\":\"" << backend() << "\",\"source_clock\":";
+  json_number(out, ros::Time::now().toSec());
+  for (const auto& group : {std::make_pair("stage_ms", &times), std::make_pair("metrics", &metrics)}) {
+    out << ",\"" << group.first << "\":{";
+    bool first=true;
+    for (const auto& item : *group.second) {
+      if (!first) out << ',';
+      first=false; out << '"' << item.first << "\":"; json_number(out,item.second);
+    }
+    out << '}';
+  }
+  out << '}';
+  std_msgs::String msg; msg.data=out.str(); pub.publish(msg);
+  times.clear(); metrics.clear();
+}
+void compare_cuda(const double* h, const double* wh, const double* residual,
+                  std::size_t n, const double* cpu_normal, const double* cpu_rhs) {
+  if (backend()=="cpu") return;
+#ifdef GO2W_HAVE_CUDA
+  // The same immutable observations produced the CPU and GPU accumulations.
+  // Measure allocation/copies/kernel/sync together, including first-use initialization.
+  Timing timer("lio_cuda_total");
+  static NormalEquationsCUDA gpu;
+  double result[42];
+  gpu.compute(h,wh,residual,n,result);
+  double max_error=0., max_scaled=0.;
+  bool good=true;
+  for (int k=0;k<42;++k) {
+    const double expected=k<36?cpu_normal[(k%6)*6+k/6]:cpu_rhs[k-36];
+    const double error=std::abs(result[k]-expected);
+    // Diagnostic acceptance criterion, not a navigation accuracy guarantee.
+    const double bound=1e-8+1e-10*std::abs(expected);
+    good = good && std::isfinite(result[k]) && std::isfinite(expected) && error<=bound;
+    max_error=std::max(max_error,error); max_scaled=std::max(max_scaled,error/bound);
+  }
+  if (profiling()) {
+    metrics["cuda_calls"] += 1;
+    metrics["cuda_observations"] = std::max(metrics["cuda_observations"],static_cast<double>(n));
+    metrics["cuda_max_abs_error"] = std::max(metrics["cuda_max_abs_error"],max_error);
+    metrics["cuda_max_bound_ratio"] = std::max(metrics["cuda_max_bound_ratio"],max_scaled);
+  }
+  set_metric("cuda_match",good?1:0);
+  if (!good) { publish_profile(); throw std::runtime_error("CUDA shadow mismatch; estimator not updated from GPU"); }
+#else
+  throw std::runtime_error("CUDA shadow requested but this build has no CUDA backend");
+#endif
+}
+}
diff --git a/src/normal_equations.cu b/src/normal_equations.cu
new file mode 100644
index 0000000..0794d71
--- /dev/null
+++ b/src/normal_equations.cu
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: MIT
+#include "normal_equations.h"
+#include <cuda_runtime.h>
+#include <algorithm>
+#include <stdexcept>
+#include <string>
+
+namespace go2w {
+namespace {
+void check(cudaError_t code, const char* operation) {
+  if (code != cudaSuccess)
+    throw std::runtime_error(std::string(operation) + ": " + cudaGetErrorString(code));
+}
+// Fixed reduction tree; no floating-point atomic additions or reduced precision.
+__global__ void accumulate(const double* h, const double* wh,
+                           const double* residual, int n, double* result) {
+  __shared__ double values[256];
+  const int component = blockIdx.x;
+  const int row = component < 36 ? component / 6 : component - 36;
+  const int col = component % 6;
+  double value = 0.0;
+  for (int i = threadIdx.x; i < n; i += blockDim.x)
+    value += wh[i * 6 + row] * (component < 36 ? h[col * n + i] : residual[i]);
+  values[threadIdx.x] = value;
+  __syncthreads();
+  for (int stride = 128; stride > 0; stride /= 2) {
+    if (threadIdx.x < stride) values[threadIdx.x] += values[threadIdx.x + stride];
+    __syncthreads();
+  }
+  if (threadIdx.x == 0) result[component] = values[0];
+}
+}
+
+struct NormalEquationsCUDA::Impl {
+  double* input = nullptr;
+  double* output = nullptr;
+  std::size_t capacity = 0;
+  cudaStream_t stream = nullptr;
+  ~Impl() {
+    if (stream) cudaStreamSynchronize(stream);
+    if (input) cudaFree(input);
+    if (output) cudaFree(output);
+    if (stream) cudaStreamDestroy(stream);
+  }
+};
+
+NormalEquationsCUDA::NormalEquationsCUDA() : impl_(new Impl) {
+  try {
+    check(cudaStreamCreateWithFlags(&impl_->stream, cudaStreamNonBlocking), "create stream");
+    check(cudaMalloc(&impl_->output, 42 * sizeof(double)), "allocate output");
+  } catch (...) { delete impl_; throw; }
+}
+NormalEquationsCUDA::~NormalEquationsCUDA() { delete impl_; }
+
+void NormalEquationsCUDA::compute(const double* h, const double* wh,
+                                  const double* residual, std::size_t n, double* result) {
+  // Bound memory use; oversize inputs fail explicitly instead of truncating.
+  if (!result || n > 2000000 || (n && (!h || !wh || !residual)))
+    throw std::invalid_argument("Invalid normal-equation input/count");
+  if (!n) { std::fill(result, result + 42, 0.0); return; }
+  if (n > impl_->capacity) {
+    double* next = nullptr;
+    check(cudaMalloc(&next, n * 13 * sizeof(double)), "allocate observations");
+    if (impl_->input) cudaFree(impl_->input);
+    impl_->input = next;
+    impl_->capacity = n;
+  }
+  double* dh = impl_->input;
+  double* dwh = dh + 6 * n;
+  double* dr = dwh + 6 * n;
+  check(cudaMemcpyAsync(dh, h, 6*n*sizeof(double), cudaMemcpyHostToDevice, impl_->stream), "copy H");
+  check(cudaMemcpyAsync(dwh, wh, 6*n*sizeof(double), cudaMemcpyHostToDevice, impl_->stream), "copy weighted H");
+  check(cudaMemcpyAsync(dr, residual, n*sizeof(double), cudaMemcpyHostToDevice, impl_->stream), "copy residual");
+  accumulate<<<42, 256, 0, impl_->stream>>>(dh, dwh, dr, static_cast<int>(n), impl_->output);
+  check(cudaGetLastError(), "launch accumulation");
+  check(cudaMemcpyAsync(result, impl_->output, 42*sizeof(double), cudaMemcpyDeviceToHost, impl_->stream), "copy result");
+  check(cudaStreamSynchronize(impl_->stream), "complete accumulation");
+}
+}
