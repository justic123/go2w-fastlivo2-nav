+  // Reject malformed/empty input before PCL conversion or indexing first/last points.
+  if (msg->width == 0 || msg->height == 0) return;
+  const std::pair<const char*, uint8_t> required[] = {
+      {"x", sensor_msgs::PointField::FLOAT32}, {"y", sensor_msgs::PointField::FLOAT32},
+      {"z", sensor_msgs::PointField::FLOAT32}, {"intensity", sensor_msgs::PointField::FLOAT32},
+      {"ring", sensor_msgs::PointField::UINT16}, {"timestamp", sensor_msgs::PointField::FLOAT64}};
+  for (const auto& field : required)
+  {
+    const auto found = std::find_if(msg->fields.begin(), msg->fields.end(),
+        [&](const sensor_msgs::PointField& f) { return f.name == field.first; });
+    if (found == msg->fields.end() || found->datatype != field.second || found->count != 1)
+    {
+      ROS_ERROR_THROTTLE(2.0, "XT input needs x/y/z/intensity float32, ring uint16, timestamp float64 seconds");
+      return;
+    }
+    const size_t bytes = field.second == sensor_msgs::PointField::FLOAT64 ? 8 :
+                         field.second == sensor_msgs::PointField::UINT16 ? 2 : 4;
+    if (uint64_t(found->offset) + bytes > msg->point_step) return;
+  }
+  if (uint64_t(msg->width) * msg->point_step > msg->row_step ||
+      uint64_t(msg->row_step) * msg->height > msg->data.size()) return;
